[Unit]
Description=Image Agent Studio history and session service
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/image-agent-studio
Environment=NODE_ENV=production
Environment=STUDIO_AUTH_MODE=standalone
Environment=STUDIO_AUTH_DB_PATH=/var/lib/image-agent-studio/auth.sqlite
Environment=STUDIO_AUTH_PASSWORD_MIN_LENGTH=8
Environment=STUDIO_AUTH_PASSWORD_ITERATIONS=600000
Environment=STUDIO_CREDITS_ENABLED=false
Environment=STUDIO_USER_PROVIDER_ONLY=true
Environment=STUDIO_MASTER_KEY=
Environment=STUDIO_ALLOW_PRIVATE_PROVIDER_URLS=false
EnvironmentFile=-/etc/image-agent-studio.env
Environment=STUDIO_DATA_DIR=/var/lib/image-agent-studio
Environment=STUDIO_LIBRARY_DIR=/var/lib/image-agent-studio/library
Environment=STUDIO_LIBRARY_ASSET_DIR=/var/lib/image-agent-studio/library/image-library
Environment=STUDIO_HISTORY_HOST=127.0.0.1
Environment=STUDIO_HISTORY_PORT=8787
Environment=STUDIO_ALLOWED_ORIGINS=https://studio.example.com
Environment=STUDIO_SESSION_QUEUE_LIMIT=0
Environment=STUDIO_JOB_LIMIT=0
Environment=STUDIO_JOB_TIMEOUT_MS=2700000
Environment=STUDIO_GATEWAY_FETCH_TIMEOUT_MS=2640000
Environment=STUDIO_JOB_CONCURRENCY=0
ExecStart=/usr/bin/node /opt/image-agent-studio/scripts/image-agent-studio-history-service.mjs
Restart=always
RestartSec=3
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
