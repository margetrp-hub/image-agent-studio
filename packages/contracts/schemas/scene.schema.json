{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://image-agent-studio.dev/contracts/v1/scene.schema.json",
  "title": "Scene",
  "type": "object",
  "required": ["schemaVersion", "id", "projectId", "order", "title", "shotIds", "createdAt", "updatedAt"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "projectId": { "$ref": "common.schema.json#/$defs/id" },
    "order": { "type": "integer", "minimum": 1 },
    "title": { "$ref": "common.schema.json#/$defs/shortText" },
    "summary": { "type": "string", "maxLength": 4000 },
    "shotIds": { "$ref": "common.schema.json#/$defs/idList" },
    "promptConstraints": { "$ref": "common.schema.json#/$defs/promptConstraints" },
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" },
    "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "updatedAt": { "$ref": "common.schema.json#/$defs/timestamp" }
  },
  "additionalProperties": false
}
