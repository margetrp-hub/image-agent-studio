{
  "name": "image-agent-studio-theme",
  "version": 1,
  "displayName": {
    "en": "Image Agent Studio",
    "zh-CN": "创作工作台"
  },
  "spacing": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px"
  },
  "radius": {
    "control": "10px",
    "panel": "18px",
    "sheet": "22px",
    "round": "999px"
  },
  "stroke": {
    "hairline": "1px",
    "focus": "2px",
    "canvasLink": "1.25px"
  },
  "typography": {
    "family": "Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif",
    "size": {
      "caption": "12px",
      "body": "14px",
      "bodyLarge": "16px",
      "title": "20px",
      "display": "28px"
    },
    "weight": {
      "regular": "400",
      "medium": "500",
      "semibold": "650"
    }
  },
  "motion": {
    "quick": "120ms",
    "normal": "180ms",
    "slow": "260ms",
    "ease": "cubic-bezier(0.2, 0.8, 0.2, 1)"
  },
  "themes": {
    "light": {
      "color": {
        "bg": {
          "app": "#f4f7f7",
          "canvas": "#f8fbfa",
          "surface": "#ffffff",
          "surfaceMuted": "#eef3f3",
          "raised": "#ffffff"
        },
        "text": {
          "primary": "#102027",
          "secondary": "#50636b",
          "muted": "#7c8c91",
          "inverse": "#ffffff"
        },
        "border": {
          "default": "#d8e2e3",
          "subtle": "#e8efef",
          "strong": "#b9c9cb"
        },
        "accent": {
          "primary": "#0f766e",
          "primaryHover": "#0b5f59",
          "secondary": "#2b9a8f",
          "warm": "#b45309"
        },
        "status": {
          "success": "#087443",
          "warning": "#b45309",
          "danger": "#b42318",
          "info": "#0f766e"
        },
        "overlay": {
          "scrim": "rgba(15, 23, 42, 0.28)"
        }
      }
    },
    "dark": {
      "color": {
        "bg": {
          "app": "#111315",
          "canvas": "#171a1f",
          "surface": "#1d2127",
          "surfaceMuted": "#252b33",
          "raised": "#242a32"
        },
        "text": {
          "primary": "#f7f8fa",
          "secondary": "#c4ccd6",
          "muted": "#8994a2",
          "inverse": "#101418"
        },
        "border": {
          "default": "#39424f",
          "subtle": "#2d3540",
          "strong": "#5c6877"
        },
        "accent": {
          "primary": "#4ecdc4",
          "primaryHover": "#7be0d8",
          "secondary": "#70d7cf",
          "warm": "#f7b267"
        },
        "status": {
          "success": "#62d69a",
          "warning": "#f7b267",
          "danger": "#ff8a80",
          "info": "#4ecdc4"
        },
        "overlay": {
          "scrim": "rgba(0, 0, 0, 0.42)"
        }
      }
    }
  },
  "product": {
    "composer": {
      "collapsedHeight": "72px",
      "expandedMaxWidth": "920px"
    },
    "canvas": {
      "linkStroke": "{stroke.canvasLink}",
      "selectionStroke": "{stroke.focus}"
    },
    "referencePanel": {
      "thumbnailRadius": "{radius.control}"
    },
    "queue": {
      "progressHeight": "6px"
    }
  }
}
